{
  "name": "glance",
  "version": "0.10.0",
  "private": true,
  "license": "MIT",
  "description": "A menu bar calendar for macOS.",
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "app": "tauri build --debug --bundles app --config src-tauri/tauri.dev.conf.json && open src-tauri/target/debug/bundle/macos/Glance.app",
    "build": "pnpm typecheck && node scripts/copy-static.mjs",
    "dev": "pnpm build && tauri dev",
    "dmg": "node scripts/release-dmg.mjs",
    "dmg:background": "swift scripts/generate-dmg-background.swift && tiffutil -cathidpicheck icons/dmg/background.png icons/dmg/background@2x.png -out icons/dmg/background.tiff && rm icons/dmg/background.png icons/dmg/background@2x.png",
    "icon": "swift scripts/generate-icon.swift",
    "test": "pnpm test:ui && pnpm test:rust",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "symbols": "swift scripts/generate-symbols.swift",
    "dmg:unnotarized": "node scripts/release-dmg.mjs --unnotarized"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.0"
  }
}
