{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "calendar",
  "description": "The month popover: reads settings and events, draws the menu bar item, sizes itself, opens or joins an event, stops counting down to one, keeps the menu's Join item current, and ticks off reminders.",
  "windows": [
    "calendar"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-settings",
    "allow-system-region",
    "allow-get-calendar-events",
    "allow-get-dismissed-events",
    "allow-dismiss-upcoming-event",
    "allow-popover-material",
    "allow-hide-calendar",
    "allow-open-settings",
    "allow-beep",
    "allow-join-meeting",
    "allow-set-join-menu",
    "allow-complete-reminder",
    "allow-undo-completed-reminder",
    "allow-detect-dates",
    "allow-create-event",
    "allow-undo-created-event",
    "allow-open-google-event",
    "allow-request-calendar-access",
    "allow-get-calendar-access",
    "allow-set-tray-label",
    "allow-open-event",
    "allow-set-calendar-height"
  ]
}
