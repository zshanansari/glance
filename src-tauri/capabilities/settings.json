{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window: edits settings, asks for Calendar and Reminders access, and handles updates and About links.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-get-settings",
    "allow-update-settings",
    "allow-beep",
    "allow-list-calendars",
    "allow-request-calendar-access",
    "allow-get-calendar-access",
    "allow-request-reminders-access",
    "allow-get-reminders-access",
    "allow-app-version",
    "allow-check-for-updates",
    "allow-update-available",
    "allow-install-update",
    "allow-open-repository",
    "allow-open-link",
    "allow-hide-settings",
    "allow-sidebar-size"
  ]
}
