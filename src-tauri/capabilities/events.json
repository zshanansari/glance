{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "events",
  "description": "The upcoming events popover: reads events, sizes itself, opens or dismisses an event, and joins a meeting.",
  "windows": [
    "events"
  ],
  "permissions": [
    "core:event:default",
    "allow-get-settings",
    "allow-get-calendar-events",
    "allow-get-dismissed-events",
    "allow-dismiss-upcoming-event",
    "allow-popover-material",
    "allow-hide-events",
    "allow-set-events-height",
    "allow-open-event",
    "allow-join-meeting"
  ]
}
