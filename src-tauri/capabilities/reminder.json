{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "reminder",
  "description": "The meeting reminder card: reads settings and events, shows, sizes and hides itself, dismisses or opens the meeting, and joins it.",
  "windows": [
    "reminder"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-settings",
    "allow-system-region",
    "allow-get-calendar-events",
    "allow-get-dismissed-events",
    "allow-dismiss-upcoming-event",
    "allow-popover-material",
    "allow-show-reminder",
    "allow-hide-reminder",
    "allow-set-reminder-height",
    "allow-open-event",
    "allow-join-meeting",
    "allow-open-in-maps"
  ]
}
