{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glance",
  "version": "0.7.1",
  "identifier": "com.zshanansari.glance",
  "build": {
    "frontendDist": "../dist/renderer",
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/beep.mp3"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "../icons/icon.png",
      "../icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "dmg": {
        "background": "../icons/dmg/background.tiff",
        "windowSize": {
          "width": 720,
          "height": 400
        },
        "appPosition": {
          "x": 170,
          "y": 175
        },
        "applicationFolderPosition": {
          "x": 550,
          "y": 175
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zshanansari/glance/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyRjA0M0MzRDVDRDk2QTkKUldTcGxzM1Z3MFB3MG9DNE1maGVMdkRsQUUwWkF4MDN1S2dKSE5ROEZJNmcwSjh0N2VEU3lCaDIK"
    }
  }
}
